# Neon: use a string COM pooler (host termina em -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do sistema (vai dentro do QR Code). Em produção, use o domínio real.
# Se ficar vazio, o sistema usa o endereço da requisição.
APP_URL=http://localhost:3000
