# Neon: use a string COM pooler (host termina em -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# gere com: openssl rand -base64 32
AUTH_SECRET=
# Opcional. O QR Code usa o endereço do site aberto no momento (nunca o antigo).
# APP_URL só serve de reserva quando não há requisição.
# Cadastro público: desligado. Só ligue com PERMITIR_CADASTRO=1 (não recomendado).
APP_URL=http://localhost:3000
